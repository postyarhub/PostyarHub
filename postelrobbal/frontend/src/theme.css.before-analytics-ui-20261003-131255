
/* WordPress / WooCommerce content center */
.wp-center-page{display:grid;gap:18px}
.wp-center-page .wp-page-hero{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;padding:24px 26px;border:1px solid var(--border);border-radius:20px;background:linear-gradient(135deg,var(--surface),color-mix(in srgb,var(--brand) 6%,var(--surface)));box-shadow:var(--shadow-sm)}
.wp-center-page .wp-page-hero h1{margin:4px 0 8px;font-size:27px}.wp-center-page .wp-page-hero p{margin:0;max-width:760px;color:var(--text-2);line-height:1.9}.wp-eyebrow{font-size:12px;font-weight:800;color:var(--brand);letter-spacing:.2px}.wp-connection-card{display:grid;grid-template-columns:1fr minmax(320px,1.2fr);gap:18px;align-items:center}.wp-code-row{display:flex;gap:8px;align-items:stretch}.wp-code-row code{display:block;flex:1;overflow:auto;padding:12px 14px;border:1px dashed var(--border);border-radius:12px;background:var(--surface-2);font-size:12px}.wp-sites-card,.wp-content-card{overflow:hidden}.wp-card-head{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;margin-bottom:15px}.wp-card-head h2{margin:0 0 5px;font-size:18px}.wp-card-head p{margin:0;color:var(--text-2);font-size:12.5px;line-height:1.8}.wp-site-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:12px}.wp-site-item{display:flex;justify-content:space-between;gap:14px;align-items:center;padding:14px;border:1px solid var(--border);border-radius:14px;background:var(--surface)}.wp-site-item strong{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:420px}.wp-site-meta{display:flex;gap:8px;align-items:center;margin-top:7px;color:var(--text-2);font-size:11px}.wp-site-actions{display:flex;gap:6px;flex-wrap:wrap}.wp-tabs{display:flex;gap:8px;overflow:auto;padding:4px;border:1px solid var(--border);background:var(--surface-2);border-radius:16px}.wp-tabs button{flex:0 0 auto;border:0;background:transparent;border-radius:12px;padding:11px 15px;color:var(--text-2);cursor:pointer;font:inherit;font-weight:700}.wp-tabs button.is-active{background:var(--surface);color:var(--brand);box-shadow:var(--shadow-sm)}.wp-item-list{display:grid;gap:10px}.wp-item-row{display:grid;grid-template-columns:62px minmax(0,1fr) auto;gap:13px;align-items:center;padding:12px;border:1px solid var(--border);border-radius:14px;background:var(--surface)}.wp-thumb{width:62px;height:62px;border-radius:13px;overflow:hidden;display:grid;place-items:center;background:var(--surface-2);color:var(--text-2);font-size:25px}.wp-thumb img{width:100%;height:100%;object-fit:cover}.wp-item-main{min-width:0}.wp-item-top{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.wp-item-top strong{font-size:14px}.wp-item-sub{display:flex;gap:10px;flex-wrap:wrap;color:var(--text-2);font-size:11.5px;margin-top:7px}.wp-item-excerpt{margin:7px 0 0;color:var(--text-2);font-size:12px;line-height:1.8}.wp-template-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px}.wp-template-card{border:1px solid var(--border);border-radius:15px;padding:15px;background:var(--surface)}.wp-template-top{display:flex;align-items:center;gap:8px;justify-content:space-between}.wp-template-card p{color:var(--text-2);font-size:12px;line-height:1.8}.wp-template-card pre,.wp-template-preview pre{margin:10px 0 0;padding:12px;border-radius:12px;background:var(--surface-2);white-space:pre-wrap;word-break:break-word;font:inherit;font-size:12px;line-height:1.9}.wp-template-actions{display:flex;gap:7px;margin-top:10px}.wp-template-settings{display:grid;gap:13px}.wp-template-setting-box{padding:14px;border:1px solid var(--border);border-radius:13px;background:var(--surface-2)}.wp-template-setting-box strong{display:block;margin-bottom:10px}.wp-check-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:8px}.wp-check-grid label{display:flex;gap:8px;align-items:center;padding:9px 10px;background:var(--surface);border:1px solid var(--border);border-radius:10px;cursor:pointer;font-size:12px}.wp-check-grid input{accent-color:var(--brand)}.wp-template-preview{margin-top:13px;padding:14px;border-radius:13px;border:1px solid var(--border)}.wp-campaign-list{display:grid;gap:11px}.wp-campaign-card{display:flex;justify-content:space-between;gap:16px;padding:15px;border:1px solid var(--border);border-radius:15px;background:var(--surface)}.wp-campaign-main{min-width:0}.wp-campaign-result{margin-top:8px;color:var(--text-2);font-size:11.5px}.wp-platform-line{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px}.wp-platform-pill{display:inline-flex;gap:6px;align-items:center;padding:6px 8px;border-radius:999px;background:var(--surface-2);font-size:11px}.wp-campaign-actions{display:flex;align-items:center;gap:6px;flex-wrap:wrap}.wp-form-two{display:grid;grid-template-columns:1fr 1fr;gap:12px}.wp-campaign-form{display:grid;gap:13px}.wp-campaign-channels{margin-top:2px}.wp-switch-local{display:flex!important;align-items:center;justify-content:space-between}.wp-editor-wrap{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(320px,.9fr);gap:16px}.wp-editor-source,.wp-editor-side{display:grid;gap:12px}.wp-editor-choice{display:grid;grid-template-columns:1fr 1fr;gap:8px}.wp-editor-choice button{border:1px solid var(--border);border-radius:12px;background:var(--surface);padding:12px;cursor:pointer;font:inherit;font-weight:800;color:var(--text-2)}.wp-editor-choice button.is-active{border-color:var(--brand);background:color-mix(in srgb,var(--brand) 7%,var(--surface));color:var(--brand)}.wp-editor-tip{padding:10px 12px;border-radius:11px;background:var(--surface-2);color:var(--text-2);font-size:11.5px;line-height:1.8}.wp-editor-site{margin:0;color:var(--text-2);font-size:11.5px}.wp-preview{border:1px solid var(--border);border-radius:15px;background:var(--surface);padding:14px}.wp-preview-title{font-weight:800;margin-bottom:8px}.wp-preview-image{min-height:130px;border-radius:12px;background:var(--surface-2);display:grid;place-items:center;color:var(--text-2);font-size:12px}.wp-preview-image-real{width:100%;max-height:240px;object-fit:cover;border-radius:12px}.wp-preview h3{font-size:15px;margin:12px 0 7px}.wp-preview pre{white-space:pre-wrap;word-break:break-word;font:inherit;font-size:12px;line-height:1.9;margin:0}.wp-channel-select{display:grid;gap:7px;padding:13px;border:1px solid var(--border);border-radius:14px}.wp-editor-side-title{font-weight:800;margin-bottom:3px}.wp-channel-choice{display:grid!important;grid-template-columns:18px auto minmax(0,1fr);align-items:center;gap:8px;padding:9px;border:1px solid var(--border);border-radius:11px;cursor:pointer}.wp-channel-choice.is-selected{border-color:color-mix(in srgb,var(--brand) 45%,var(--border));background:color-mix(in srgb,var(--brand) 5%,var(--surface))}.wp-channel-choice input{accent-color:var(--brand)}.wp-empty-small{color:var(--text-2);font-size:12px;padding:6px}.wp-modal-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px;justify-content:flex-start}.wp-guide-card{padding:15px 16px}.wp-guide-card>div{display:flex;flex-direction:column;gap:4px}.wp-guide-card span{color:var(--text-2);font-size:12px}.wp-campaign-card .badge{white-space:nowrap}
@media (max-width: 900px){.wp-center-page .wp-page-hero,.wp-connection-card,.wp-editor-wrap{grid-template-columns:1fr;display:grid}.wp-item-row{grid-template-columns:50px minmax(0,1fr)}.wp-item-row>button{grid-column:1 / -1;justify-self:start}.wp-campaign-card{flex-direction:column}.wp-form-two{grid-template-columns:1fr}.wp-code-row{flex-direction:column}}

/* UX v12 page refinements are kept in ux-v12.css in production to avoid touching the stable base theme. */

/* Analytics / dashboard responsive composition */
.analytics-kpi-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.analytics-platform-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.analytics-pair-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
@media (max-width: 980px){.analytics-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.analytics-platform-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width: 680px){.analytics-kpi-grid,.analytics-platform-grid,.analytics-pair-grid{grid-template-columns:1fr!important}}

/* Admin dashboard responsive composition */
.admin-kpi-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.admin-pair-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.admin-platform-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
@media (max-width:980px){.admin-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.admin-platform-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media (max-width:680px){.admin-kpi-grid,.admin-pair-grid,.admin-platform-grid{grid-template-columns:1fr!important}}
