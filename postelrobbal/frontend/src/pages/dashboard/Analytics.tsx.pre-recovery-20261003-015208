  nextCursor: string | null;
}

interface TargetDto {
  platform: string;
  channelTitle: string;
  channelRef: string;
  state: string;
  attempts: number;
  errorCode: string | null;
}

interface PostDetails {
  post: { title: string | null };
  targets: TargetDto[];
}

