import { useEffect, useMemo, useState } from 'react';
import { Link } from 'react-router-dom';
import { api } from '../../lib/api';
import { Badge, Card, EmptyState, PageLoading } from '../../components/ui';
import { NavIcon } from '../../components/icons';
import { PLATFORM_FA, faFileSize, faMoney, faNumber } from '../../lib/format';
import { useToast } from '../../lib/toast';
import { ADMIN_SECTIONS_FLAT, PlatformIcon, errText, type AdminOverview } from './shared';

type PF = 'telegram'|'bale'|'rubika';
interface AdminAnalytics { events:{total:number;sent:number;failed:number}; successRate:number; platforms:Record<string,{sent:number;failed:number}>; revenue:{paymentsCompletedRial:number;subscriptionRevenueRial:number;paymentsCompleted:number;subscriptionsRenewed:number}; automation:{ai:{requested:number;completed:number;failed:number;successRate:number};workflows:{started:number;completed:number;failed:number;successRate:number}}; links:{clicks:number}; }

function Bar({ value, max }: { value: number; max: number }) { return <div style={{ height: 9, borderRadius: 999, background: 'var(--surface-2)', overflow: 'hidden' }}><div style={{ height: '100%', width: `${max ? Math.min(100, value/max*100) : 0}%`, background: 'var(--brand)', borderRadius: 999 }} /></div>; }
function KPI({ to, icon, label, value, meta }: { to?: string; icon: string; label: string; value: string; meta?: string }) { const body=<Card style={{ minWidth:0, height:'100%', transition:'transform .18s ease, box-shadow .18s ease' }}><div style={{display:'flex',justifyContent:'space-between',gap:10}}><span style={{fontSize:23}}>{icon}</span>{to?<span style={{fontSize:12,color:'var(--brand)'}}>مشاهده ←</span>:null}</div><div style={{fontSize:23,fontWeight:900,marginTop:10}}>{value}</div><div style={{fontSize:12.5,color:'var(--text-2)',marginTop:3}}>{label}</div>{meta?<div style={{fontSize:11.5,color:'var(--text-2)',marginTop:6}}>{meta}</div>:null}</Card>; return to?<Link to={to} style={{textDecoration:'none',color:'inherit'}}>{body}</Link>:body; }

export default function AdminHome() {
  const toast=useToast(); const [data,setData]=useState<AdminOverview|null>(null); const [analytics,setAnalytics]=useState<AdminAnalytics|null>(null); const [loading,setLoading]=useState(true);
  useEffect(()=>{let alive=true;(async()=>{const [overviewResult,analyticsResult]=await Promise.allSettled([api.get<AdminOverview>('/api/v1/admin/overview'),api.get<AdminAnalytics>('/api/v1/admin/analytics/overview?days=30')]);if(!alive)return;if(overviewResult.status==='fulfilled')setData(overviewResult.value);else toast.error(errText(overviewResult.reason,'دریافت آمار مدیریتی ناموفق بود.'));if(analyticsResult.status==='fulfilled')setAnalytics(analyticsResult.value);else toast.error(errText(analyticsResult.reason,'دریافت هستهٔ تحلیلی ناموفق بود.'));setLoading(false)})();return()=>{alive=false}},[toast]);
  const planTotal=data?.subscriptions?.active??0; const plans=data?.subscriptions?.byPlan??[]; const maxPlan=Math.max(1,...plans.map(p=>p.count));
  const pfData = useMemo(()=>{const b=data?.bots?.byPlatform;const c=data?.channels?.byPlatform; return (['telegram','bale','rubika'] as PF[]).map(p=>({platform:p,channels:c?.[p]??{total:data?.channels?.[p]??0,active:0,inactive:0},bots:b?.[p]??{total:data?.bots?.[p]??0,active:0,inactive:0}}))},[data]);
  if(loading)return <PageLoading/>;
  return <div style={{display:'grid',gap:18}}>
    <div className="adm-page-head"><h2>مرکز مدیریت</h2><p>نمای عملیاتی کاربران، درآمد، اتصال پلتفرم‌ها، اشتراک و موتور تحلیل مشترک.</p></div>
    <section className="admin-kpi-grid" style={{display:'grid',gap:12}}>
      <KPI to="/dashboard/admin/users" icon="👥" label="کاربران کل" value={faNumber(data?.users?.total??0)} meta={`فعال ${faNumber(data?.users?.active??0)} · جدید ۳۰ روز ${faNumber(data?.users?.new30d??0)}`}/>
      <KPI to="/dashboard/admin/users" icon="✅" label="کاربران فعال" value={faNumber(data?.users?.active??0)} meta={`تعلیق‌شده ${faNumber(data?.users?.suspended??0)}`}/>
      <KPI to="/dashboard/admin/payments" icon="💳" label="درآمد تأییدشده ۳۰ روز" value={faMoney(data?.payments?.verifiedSum30d??0)} meta={`تعداد پرداخت ${faNumber(data?.payments?.verifiedCount30d??0)}`}/>
      <KPI to="/dashboard/admin/plans" icon="💎" label="اشتراک فعال" value={faNumber(data?.subscriptions?.active??0)} meta="تفکیک پلن در پایین صفحه"/>
    </section>

    <section className="admin-pair-grid" style={{display:'grid',gap:14}}>
      {(['channels','bots'] as const).map(kind=><Card key={kind}><div style={{display:'flex',justifyContent:'space-between',alignItems:'center',marginBottom:14}}><div><h3 style={{margin:0,fontSize:16,fontWeight:850}}>{kind==='channels'?'کانال‌ها':'ربات‌ها'}</h3><div style={{color:'var(--text-2)',fontSize:12.5,marginTop:4}}>فعال، غیرفعال و تفکیک پلتفرم</div></div><Link to={kind==='channels'?'/dashboard/admin/channels':'/dashboard/admin/bots'}>مدیریت ←</Link></div><div className="admin-platform-grid" style={{display:'grid',gap:10}}>{pfData.map(p=>{const x=p[kind];return <div key={p.platform} style={{padding:11,border:'1px solid var(--border)',borderRadius:13,background:'var(--surface-2)'}}><div style={{display:'flex',alignItems:'center',gap:7}}><PlatformIcon platform={p.platform} size={20}/><strong>{PLATFORM_FA[p.platform]}</strong></div><div style={{fontSize:20,fontWeight:900,marginTop:8}}>{faNumber(x.total)}</div><div style={{display:'flex',gap:5,marginTop:5,flexWrap:'wrap'}}><Badge tone="success">فعال {faNumber(x.active)}</Badge><Badge tone="muted">غیرفعال {faNumber(x.inactive)}</Badge></div></div>})}</div></Card>)}
    </section>

    <Card><div style={{display:'flex',justifyContent:'space-between',alignItems:'center',marginBottom:14,gap:10,flexWrap:'wrap'}}><div><h3 style={{margin:0,fontSize:16,fontWeight:850}}>هستهٔ تحلیلی مشترک</h3><div style={{color:'var(--text-2)',fontSize:12.5,marginTop:4}}>۳۰ روز اخیر · Content · Delivery · Revenue · Automation</div></div><Link to="/dashboard/analytics">تحلیل کامل ←</Link></div>{analytics?<div style={{display:'grid',gap:14}}><div style={{display:'grid',gap:10,gridTemplateColumns:'repeat(4,minmax(0,1fr))'}}>{[['کل رویداد',analytics.events.total,'📚'],['ارسال موفق',analytics.events.sent,'✅'],['خطا',analytics.events.failed,'⚠️'],['کلیک لینک',analytics.links.clicks,'🔗']].map(([l,v,i])=><Link key={String(l)} to="/dashboard/analytics" style={{textDecoration:'none',color:'inherit',padding:12,border:'1px solid var(--border)',borderRadius:14,background:'var(--surface-2)'}}><div style={{display:'flex',justifyContent:'space-between'}}><span style={{fontSize:19}}>{i}</span><span style={{fontSize:11.5,color:'var(--brand)'}}>تحلیل ←</span></div><div style={{fontSize:22,fontWeight:900,marginTop:7}}>{faNumber(Number(v))}</div><div style={{color:'var(--text-2)',fontSize:12}}>{l}</div></Link>)}</div><div style={{display:'grid',gap:10,gridTemplateColumns:'minmax(0,1.25fr) minmax(0,.75fr)'}}><div style={{padding:12,border:'1px solid var(--border)',borderRadius:14}}><div style={{fontWeight:800,marginBottom:10}}>عملکرد پلتفرم‌ها</div>{(['telegram','bale','rubika','wordpress'] as const).map(p=>{const x=analytics.platforms?.[p]??{sent:0,failed:0};const total=Number(x.sent)+Number(x.failed);return <div key={p} style={{display:'grid',gap:5,marginBottom:9}}><div style={{display:'flex',justifyContent:'space-between',fontSize:12}}><span>{PLATFORM_FA[p]}</span><span>{faNumber(total)}</span></div><Bar value={Number(x.sent)} max={Math.max(1,total)}/><div style={{display:'flex',gap:6,flexWrap:'wrap'}}><Badge tone="success">موفق {faNumber(Number(x.sent))}</Badge><Badge tone="danger">خطا {faNumber(Number(x.failed))}</Badge></div></div>})}</div><div style={{padding:12,border:'1px solid var(--border)',borderRadius:14,background:'linear-gradient(180deg,var(--surface),var(--surface-2))'}}><div style={{fontWeight:800}}>خلاصه درآمد و اتوماسیون</div><div style={{display:'grid',gap:9,marginTop:10,fontSize:12.5}}><div style={{display:'flex',justifyContent:'space-between'}}><span>درآمد موفق</span><strong>{faMoney(analytics.revenue.paymentsCompletedRial)}</strong></div><div style={{display:'flex',justifyContent:'space-between'}}><span>تمدید اشتراک</span><strong>{faNumber(analytics.revenue.subscriptionsRenewed)}</strong></div><div style={{display:'flex',justifyContent:'space-between'}}><span>AI کامل‌شده</span><strong>{faNumber(analytics.automation.ai.completed)}</strong></div><div style={{display:'flex',justifyContent:'space-between'}}><span>گردش‌کار کامل‌شده</span><strong>{faNumber(analytics.automation.workflows.completed)}</strong></div></div></div></div></div>:<EmptyState icon="📊" title="داده تحلیل در دسترس نیست" description="بعد از ثبت رویدادهای جدید، شاخص‌ها اینجا نمایش داده می‌شوند."/>}</Card>

    <section style={{display:'grid',gap:14,gridTemplateColumns:'minmax(0,1fr) minmax(0,1fr)'}}>
      <Card><div style={{display:'flex',justifyContent:'space-between',marginBottom:12}}><h3 style={{margin:0,fontSize:15.5}}>اشتراک‌های فعال به تفکیک پلن</h3><Badge tone="brand">{faNumber(planTotal)} فعال</Badge></div>{plans.length===0?<EmptyState icon="💎" title="اشتراک فعالی نیست" description="توزیع پلن‌ها پس از فعال‌شدن اشتراک نمایش داده می‌شود."/>:<div style={{display:'grid',gap:13}}>{plans.map(p=><div key={p.planName}><div style={{display:'flex',justifyContent:'space-between',marginBottom:6,fontSize:12.5}}><strong>{p.planName}</strong><span>{faNumber(p.count)} · {planTotal?faNumber(Math.round(p.count/planTotal*100)):0}٪</span></div><Bar value={p.count} max={maxPlan}/></div>)}</div>}</Card>
      <Card><div style={{display:'flex',justifyContent:'space-between',marginBottom:12}}><h3 style={{margin:0,fontSize:15.5}}>عملکرد و مصرف</h3><Link to="/dashboard/posts">پست‌ها ←</Link></div><div style={{display:'grid',gap:10}}><div style={{display:'flex',justifyContent:'space-between'}}><span>پست‌های کل</span><strong>{faNumber(data?.posts?.total??0)}</strong></div><div style={{display:'flex',justifyContent:'space-between'}}><span>منتشرشده ۳۰ روز</span><strong>{faNumber(data?.posts?.published30d??0)}</strong></div><div style={{display:'flex',justifyContent:'space-between'}}><span>ارسال موفق ۲۴ ساعت</span><strong>{faNumber(data?.usage?.deliveries24h??0)}</strong></div><div style={{display:'flex',justifyContent:'space-between'}}><span>ارسال ناموفق ۲۴ ساعت</span><strong>{faNumber(data?.usage?.deliveriesFailed24h??0)}</strong></div><div style={{display:'flex',justifyContent:'space-between'}}><span>حجم رسانه</span><strong>{faFileSize(data?.usage?.mediaBytes??0)}</strong></div></div></Card>
    </section>

    <Card><div className="adm-card-head"><strong>دسترسی سریع</strong><span className="adm-card-head__meta">بخش‌های قابل رهگیری</span></div><div className="adm-quick">{ADMIN_SECTIONS_FLAT.filter(s=>!s.end).map(s=><Link key={s.to} to={s.to} className="adm-quick__tile"><span className="adm-quick__icon"><NavIcon name={s.icon} size={19}/></span><span>{s.label}</span></Link>)}</div></Card>
  </div>;
}
