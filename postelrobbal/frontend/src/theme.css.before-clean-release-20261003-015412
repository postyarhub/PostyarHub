/* UX v12 page refinements are kept in ux-v12.css in production to avoid touching the stable base theme. */

/* Analytics / dashboard responsive composition */
.analytics-kpi-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.analytics-platform-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.analytics-pair-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
@media (max-width: 980px){.analytics-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.analytics-platform-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width: 680px){.analytics-kpi-grid,.analytics-platform-grid,.analytics-pair-grid{grid-template-columns:1fr!important}}

/* Admin dashboard responsive composition */
.admin-kpi-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.admin-pair-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.admin-platform-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
@media (max-width:980px){.admin-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.admin-platform-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media (max-width:680px){.admin-kpi-grid,.admin-pair-grid,.admin-platform-grid{grid-template-columns:1fr!important}}

/* Analytics dashboard composition */
.analytics-page{display:grid;gap:18px;min-width:0}
.analytics-hero{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;padding:22px 24px;border:1px solid var(--border);border-radius:20px;background:linear-gradient(135deg,var(--surface),color-mix(in srgb,var(--brand) 6%,var(--surface)));box-shadow:var(--shadow-sm)}
.analytics-eyebrow{display:block;margin-bottom:5px;color:var(--brand);font-size:10.5px;font-weight:900;letter-spacing:.8px}
.analytics-hero h1{margin:0;font-size:25px;font-weight:900}
.analytics-hero p{margin:7px 0 0;color:var(--text-2);font-size:13px;line-height:1.8}
.analytics-kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.analytics-kpi{min-width:0;min-height:126px;display:flex;align-items:center;gap:14px;padding:18px!important;position:relative;overflow:hidden}
.analytics-kpi__icon{width:46px;height:46px;display:grid;place-items:center;flex:0 0 46px;border-radius:15px;background:var(--surface-2);font-size:23px}
.analytics-kpi>div{min-width:0}
.analytics-kpi strong{display:block;font-size:25px;line-height:1.2;font-weight:900}
.analytics-kpi span:not(.analytics-kpi__icon){display:block;margin-top:5px;font-size:12.5px;font-weight:800}
.analytics-kpi small{display:block;margin-top:5px;color:var(--text-2);font-size:10.8px;line-height:1.6}
.analytics-kpi--primary{border-color:color-mix(in srgb,var(--brand) 28%,var(--border))}
.analytics-kpi--ring{gap:12px}
.analytics-kpi--ring>div:last-child{min-width:0}
.analytics-ring{--ring-value:0%;width:64px;height:64px;flex:0 0 64px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(var(--brand) var(--ring-value),var(--surface-2) 0);position:relative}
.analytics-ring::before{content:"";position:absolute;inset:6px;border-radius:50%;background:var(--surface)}
.analytics-ring__inner{position:relative;z-index:1;text-align:center}
.analytics-ring__inner strong{display:block;font-size:12px;font-weight:900}
.analytics-ring__inner span{display:block;margin:2px 0 0;color:var(--text-2);font-size:8.5px;font-weight:700}
.analytics-panel{min-width:0;overflow:hidden}
.analytics-panel__head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;margin-bottom:16px}
.analytics-panel__head h2{margin:0;font-size:17px;font-weight:900}
.analytics-panel__head p{margin:5px 0 0;color:var(--text-2);font-size:11.8px;line-height:1.75}
.analytics-platform-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.analytics-platform-card{min-width:0;padding:15px;border:1px solid var(--border);border-radius:16px;background:var(--surface-2)}
.analytics-platform-card__head{display:flex;justify-content:space-between;align-items:center;gap:8px}
.analytics-platform-card__head>div{display:flex;align-items:center;gap:8px;min-width:0}
.analytics-platform-card__head strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px}
.analytics-platform-card__total{margin:16px 0 10px;font-size:25px;font-weight:900}
.analytics-platform-card__total span{margin-right:5px;color:var(--text-2);font-size:11px;font-weight:600}
.analytics-progress{height:9px;border-radius:999px;background:var(--surface);overflow:hidden}
.analytics-progress__fill{height:100%;border-radius:999px;transition:width .25s ease}
.analytics-progress__fill--brand{background:var(--brand)}
.analytics-progress__fill--success{background:var(--success)}
.analytics-progress__fill--danger{background:var(--danger)}
.analytics-platform-card__stats{display:flex;justify-content:space-between;gap:8px;margin-top:9px;color:var(--text-2);font-size:11.5px}
.analytics-platform-card__stats b{color:var(--text);margin-right:3px}
.analytics-main-grid{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(360px,.88fr);gap:14px;align-items:start}
.analytics-post-list,.analytics-error-list{display:grid;gap:0}
.analytics-post-row{padding:12px 0;border-bottom:1px solid var(--border)}
.analytics-post-row:first-child{padding-top:0}
.analytics-post-row:last-child{padding-bottom:0;border-bottom:0}
.analytics-post-row__top{display:flex;justify-content:space-between;align-items:center;gap:10px}
.analytics-post-row__top a{min-width:0;color:var(--text);font-size:13px;font-weight:850;text-decoration:none;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.analytics-post-row__top a:hover{color:var(--brand)}
.analytics-post-row__targets{display:flex;gap:7px;flex-wrap:wrap;margin-top:9px}
.analytics-target-pill{display:inline-flex;align-items:center;gap:6px;max-width:100%;padding:6px 8px;border:1px solid var(--border);border-radius:10px;background:var(--surface-2);font-size:10.5px}
.analytics-target-pill b{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.analytics-target-pill span{color:var(--text-2)}
.analytics-muted{margin-top:8px;color:var(--text-2);font-size:11.5px}
.analytics-error-row{padding:12px 0;border-bottom:1px solid var(--border)}
.analytics-error-row:first-child{padding-top:0}
.analytics-error-row:last-child{padding-bottom:0;border-bottom:0}
.analytics-error-row__main{display:flex;justify-content:space-between;gap:10px;align-items:center}
.analytics-error-row__main>div{min-width:0}
.analytics-error-row__main strong{display:block;font-size:13px}
.analytics-error-row__main span{display:block;margin-top:4px;color:var(--text-2);font-size:10.8px}
.analytics-error-row p{margin:7px 0 0;padding:8px 10px;border-radius:10px;background:var(--surface-2);color:var(--text-2);font-size:11px;line-height:1.75}
.analytics-error-row p b{color:var(--text)}
.analytics-automation-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.analytics-automation-card{min-width:0;padding:15px;border:1px solid var(--border);border-radius:16px;background:var(--surface-2)}
.analytics-automation-card__head{display:flex;justify-content:space-between;align-items:center;gap:12px}
.analytics-automation-card__head>div{min-width:0}
.analytics-automation-card__head span,.analytics-automation-card__head small{display:block;color:var(--text-2);font-size:11px}
.analytics-automation-card__head strong{display:block;margin-top:4px;font-size:23px;font-weight:900}
.analytics-mini-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin-top:14px}
.analytics-mini-stats span{padding:7px 8px;border:1px solid var(--border);border-radius:9px;background:var(--surface);color:var(--text-2);font-size:10.5px}
.analytics-mini-stats b{display:block;margin-top:2px;color:var(--text);font-size:12px}
.analytics-revenue-hero{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;padding:16px;border:1px solid var(--border);border-radius:15px;background:linear-gradient(180deg,var(--surface-2),var(--surface))}
.analytics-revenue-hero span,.analytics-revenue-hero small{display:block;color:var(--text-2);font-size:10.8px}
.analytics-revenue-hero strong{display:block;margin-top:5px;font-size:24px;font-weight:900}
.analytics-revenue-chip{padding:7px 9px;border-radius:999px;background:var(--surface-2);color:var(--text-2);font-size:10.5px;white-space:nowrap}
.analytics-stat-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:10px}
.analytics-stat-grid>div{padding:10px 11px;border:1px solid var(--border);border-radius:11px}
.analytics-stat-grid span{display:block;color:var(--text-2);font-size:10.8px}
.analytics-stat-grid strong{display:block;margin-top:4px;font-size:15px;font-weight:850;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.analytics-chart-wrap{padding:10px 2px 0;border-radius:14px;background:linear-gradient(180deg,color-mix(in srgb,var(--brand) 5%,var(--surface)),var(--surface))}
.analytics-sparkline{width:100%;height:104px;display:block}
.analytics-empty-chart{display:grid;place-items:center;height:104px;color:var(--text-2);font-size:12px}
.analytics-day-strip{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:7px;margin-top:10px}
.analytics-day-strip>div{padding:8px 5px;text-align:center;border:1px solid var(--border);border-radius:10px;background:var(--surface-2)}
.analytics-day-strip span{display:block;color:var(--text-2);font-size:9.5px}
.analytics-day-strip strong{display:block;margin-top:3px;font-size:12px}
.analytics-events-list{display:grid;gap:8px}
.analytics-event-row{display:grid;grid-template-columns:9px minmax(0,1fr) auto;gap:10px;align-items:start;padding:10px 11px;border:1px solid var(--border);border-radius:12px;background:var(--surface-2)}
.analytics-event-row>div{min-width:0}
.analytics-event-row strong{display:block;font-size:11.8px}
.analytics-event-row small{display:block;margin-top:3px;color:var(--text-2);font-size:10.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.analytics-event-row>span:last-child{color:var(--text-2);font-size:10.5px;white-space:nowrap}
.analytics-event-dot{width:8px;height:8px;margin-top:4px;border-radius:50%;background:var(--brand)}
.analytics-event-dot--danger{background:var(--danger)}
@media (max-width:1080px){
  .analytics-kpi-grid,.analytics-platform-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .analytics-main-grid{grid-template-columns:1fr}
  .analytics-automation-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media (max-width:680px){
  .analytics-kpi-grid,.analytics-platform-grid,.analytics-automation-grid,.analytics-stat-grid{grid-template-columns:1fr}
  .analytics-hero{align-items:flex-start;padding:18px}
  .analytics-hero h1{font-size:22px}
  .analytics-kpi{min-height:106px}
  .analytics-mini-stats{grid-template-columns:repeat(2,minmax(0,1fr))}
  .analytics-day-strip{grid-template-columns:repeat(4,minmax(0,1fr))}
  .analytics-post-row__top{align-items:flex-start}
  .analytics-event-row{grid-template-columns:8px minmax(0,1fr)}
  .analytics-event-row>span:last-child{grid-column:2}
  .analytics-platform-card__total{font-size:23px}
}

/* ===== Analytics / Admin V4 presentation ===== */

.analytics-v4-page,
.admin-v3-page{
  width:100%;
  min-width:0;
  display:grid;
  gap:16px;
  overflow:hidden;
}

.analytics-v4-hero,
.admin-v3-hero{
  display:flex;
  align-items:flex-end;
  justify-content:space-between;
  gap:16px;
  flex-wrap:wrap;
  padding:20px 22px;
  border:1px solid var(--border);
  border-radius:18px;
  background:var(--surface);
  box-shadow:var(--shadow-sm);
}

.analytics-v4-eyebrow,
.admin-v3-hero>div>span{
  display:block;
  color:var(--brand);
  font-size:10px;
  font-weight:900;
  letter-spacing:.5px;
  margin-bottom:5px;
}

.analytics-v4-hero h1,
.admin-v3-hero h1{
  margin:0;
  font-size:22px;
  line-height:1.45;
  font-weight:900;
}

.analytics-v4-hero p,
.admin-v3-hero p{
  margin:5px 0 0;
  color:var(--text-2);
  font-size:12px;
  line-height:1.85;
}

.analytics-v4-kpis,
.admin-v3-kpis{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:12px;
}

.analytics-v4-kpi,
.admin-v3-kpi{
  min-width:0;
  min-height:112px;
  padding:15px!important;
  border-radius:14px;
  box-shadow:none;
}

.analytics-v4-kpi{
  display:flex;
  align-items:center;
  gap:12px;
}

.analytics-v4-kpi__icon{
  width:44px;
  height:44px;
  flex:0 0 44px;
  display:grid;
  place-items:center;
  border-radius:13px;
  background:var(--surface-2);
  font-size:21px;
}

.analytics-v4-kpi>div:last-child,
.analytics-v4-kpi>div{
  min-width:0;
}

.analytics-v4-kpi strong{
  display:block;
  font-size:23px;
  line-height:1.2;
  font-weight:900;
}

.analytics-v4-kpi span{
  display:block;
  margin-top:4px;
  font-size:12px;
  font-weight:800;
}

.analytics-v4-kpi small{
  display:block;
  margin-top:5px;
  color:var(--text-2);
  font-size:10px;
  line-height:1.6;
}

.analytics-v4-kpi--accent{
  border-color:color-mix(in srgb,var(--brand) 30%,var(--border));
}

.analytics-v4-kpi__ring{
  flex:0 0 auto;
}

.analytics-v4-ring{
  width:62px;
  height:62px;
  flex:0 0 62px;
  display:grid;
  place-items:center;
  position:relative;
  border-radius:50%;
}

.analytics-v4-ring::before{
  content:"";
  position:absolute;
  inset:6px;
  border-radius:50%;
  background:var(--surface);
}

.analytics-v4-ring>div{
  position:relative;
  z-index:1;
  text-align:center;
}

.analytics-v4-ring strong{
  display:block;
  font-size:11px!important;
  line-height:1.1;
}

.analytics-v4-ring span{
  display:block;
  margin-top:3px!important;
  color:var(--text-2);
  font-size:8px!important;
  font-weight:700;
}

.analytics-v4-section{
  min-width:0;
  overflow:hidden;
  border-radius:16px;
}

.analytics-v4-section__header,
.admin-v3-resource__head{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:12px;
  flex-wrap:wrap;
  margin-bottom:14px;
}

.analytics-v4-section__header h2,
.admin-v3-resource__head h2{
  margin:0;
  font-size:16px;
  line-height:1.6;
  font-weight:900;
}

.analytics-v4-section__header p,
.admin-v3-resource__head p{
  margin:4px 0 0;
  color:var(--text-2);
  font-size:11.5px;
  line-height:1.8;
}

.analytics-v4-platforms,
.admin-v3-platforms{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:10px;
}

.analytics-v4-platform{
  min-width:0;
  min-height:158px;
  padding:13px;
  border:1px solid var(--border);
  border-radius:14px;
  background:var(--surface-2);
}

.analytics-v4-platform__head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:8px;
}

.analytics-v4-platform__head>div{
  display:flex;
  align-items:center;
  gap:8px;
  min-width:0;
}

.analytics-v4-platform__head strong{
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  font-size:12.5px;
}

.analytics-v4-platform__number{
  margin:15px 0 8px;
  font-size:24px;
  line-height:1;
  font-weight:900;
}

.analytics-v4-platform__number span{
  margin-right:5px;
  color:var(--text-2);
  font-size:10px;
  font-weight:600;
}

.analytics-v4-progress{
  height:8px;
  border-radius:999px;
  background:var(--surface);
  overflow:hidden;
}

.analytics-v4-progress__fill{
  display:block;
  height:100%;
  border-radius:999px;
}

.analytics-v4-progress__fill--brand{
  background:var(--brand);
}

.analytics-v4-progress__fill--success{
  background:var(--success);
}

.analytics-v4-progress__fill--danger{
  background:var(--danger);
}

.analytics-v4-platform__stats{
  display:flex;
  justify-content:space-between;
  gap:8px;
  margin-top:8px;
  color:var(--text-2);
  font-size:10.5px;
}

.analytics-v4-platform__stats b{
  color:var(--text);
}

.analytics-v4-two-col{
  display:grid;
  grid-template-columns:minmax(0,1.1fr) minmax(340px,.9fr);
  gap:14px;
  align-items:start;
}

.analytics-v4-posts,
.analytics-v4-errors{
  display:grid;
}

.analytics-v4-post,
.analytics-v4-error{
  min-width:0;
  padding:11px 0;
  border-bottom:1px solid var(--border);
}

.analytics-v4-post:first-child,
.analytics-v4-error:first-child{
  padding-top:0;
}

.analytics-v4-post:last-child,
.analytics-v4-error:last-child{
  padding-bottom:0;
  border-bottom:0;
}

.analytics-v4-post__title,
.analytics-v4-error__top{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  min-width:0;
}

.analytics-v4-post__title a{
  min-width:0;
  max-width:calc(100% - 90px);
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  color:var(--text);
  text-decoration:none;
  font-size:12.5px;
  font-weight:850;
}

.analytics-v4-post__title a:hover{
  color:var(--brand);
}

.analytics-v4-post__targets{
  display:flex;
  flex-wrap:wrap;
  gap:6px;
  margin-top:8px;
}

.analytics-v4-pill{
  display:inline-flex;
  align-items:center;
  gap:6px;
  max-width:100%;
  padding:6px 8px;
  border:1px solid var(--border);
  border-radius:9px;
  background:var(--surface-2);
  color:var(--text-2);
  font-size:10px;
}

.analytics-v4-pill b{
  max-width:180px;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  color:var(--text);
}

.analytics-v4-note{
  margin-top:7px;
  color:var(--text-2);
  font-size:10.5px;
}

.analytics-v4-error__top>div{
  min-width:0;
}

.analytics-v4-error__top strong{
  display:block;
  font-size:12.5px;
}

.analytics-v4-error__top span{
  display:block;
  margin-top:3px;
  color:var(--text-2);
  font-size:10px;
}

.analytics-v4-error p{
  margin:7px 0 0;
  padding:8px 9px;
  border-radius:9px;
  background:var(--surface-2);
  color:var(--text-2);
  font-size:10.5px;
  line-height:1.8;
}

.analytics-v4-error p b{
  color:var(--text);
}

.analytics-v4-automation{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:10px;
}

.analytics-v4-automation-card{
  min-width:0;
  padding:13px;
  border:1px solid var(--border);
  border-radius:14px;
  background:var(--surface-2);
}

.analytics-v4-automation-card__head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}

.analytics-v4-automation-card__head>div{
  min-width:0;
}

.analytics-v4-automation-card__head span,
.analytics-v4-automation-card__head small{
  display:block;
  color:var(--text-2);
  font-size:10px;
}

.analytics-v4-automation-card__head strong{
  display:block;
  margin-top:4px;
  font-size:22px;
  font-weight:900;
}

.analytics-v4-statline{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:6px;
  margin-top:12px;
}

.analytics-v4-statline>div{
  min-width:0;
  padding:8px;
  border:1px solid var(--border);
  border-radius:9px;
  background:var(--surface);
}

.analytics-v4-statline span{
  display:block;
  color:var(--text-2);
  font-size:9.5px;
}

.analytics-v4-statline b{
  display:block;
  margin-top:3px;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  font-size:11px;
}

.analytics-v4-revenue-main{
  padding:14px;
  border:1px solid var(--border);
  border-radius:14px;
  background:linear-gradient(180deg,var(--surface-2),var(--surface));
}

.analytics-v4-revenue-main span,
.analytics-v4-revenue-main small{
  display:block;
  color:var(--text-2);
  font-size:10px;
}

.analytics-v4-revenue-main strong{
  display:block;
  margin-top:5px;
  font-size:24px;
  font-weight:900;
}

.analytics-v4-revenue-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:8px;
  margin-top:8px;
}

.analytics-v4-revenue-grid>div{
  min-width:0;
  padding:9px 10px;
  border:1px solid var(--border);
  border-radius:10px;
}

.analytics-v4-revenue-grid span{
  display:block;
  color:var(--text-2);
  font-size:9.5px;
}

.analytics-v4-revenue-grid b{
  display:block;
  margin-top:4px;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  font-size:13px;
}

.analytics-v4-trend{
  height:120px;
  display:flex;
  align-items:flex-end;
  gap:4px;
  padding:10px;
  border:1px solid var(--border);
  border-radius:14px;
  background:linear-gradient(180deg,var(--surface-2),var(--surface));
}

.analytics-v4-trend__item{
  flex:1 1 0;
  height:100%;
  display:flex;
  align-items:flex-end;
  min-width:2px;
}

.analytics-v4-trend__item span{
  display:block;
  width:100%;
  min-height:7px;
  border-radius:5px 5px 2px 2px;
  background:linear-gradient(180deg,var(--brand),color-mix(in srgb,var(--brand) 50%,var(--surface)));
}

.analytics-v4-empty-chart{
  display:grid;
  place-items:center;
  min-height:120px;
  border:1px dashed var(--border);
  border-radius:14px;
  color:var(--text-2);
  font-size:11px;
}

.analytics-v4-day-summary{
  display:grid;
  grid-template-columns:repeat(7,minmax(0,1fr));
  gap:6px;
  margin-top:8px;
}

.analytics-v4-day-summary>div{
  padding:7px 5px;
  text-align:center;
  border:1px solid var(--border);
  border-radius:9px;
  background:var(--surface-2);
}

.analytics-v4-day-summary span{
  display:block;
  color:var(--text-2);
  font-size:8.5px;
}

.analytics-v4-day-summary b{
  display:block;
  margin-top:2px;
  font-size:11px;
}

.analytics-v4-events{
  display:grid;
  gap:6px;
}

.analytics-v4-event{
  display:grid;
  grid-template-columns:8px minmax(0,1fr) auto;
  gap:9px;
  align-items:start;
  padding:9px 10px;
  border:1px solid var(--border);
  border-radius:11px;
  background:var(--surface-2);
}

.analytics-v4-event__dot{
  width:8px;
  height:8px;
  margin-top:5px;
  border-radius:50%;
  background:var(--brand);
}

.analytics-v4-event__dot--danger{
  background:var(--danger);
}

.analytics-v4-event strong{
  display:block;
  font-size:11px;
}

.analytics-v4-event span{
  display:block;
  margin-top:3px;
  color:var(--text-2);
  font-size:9.5px;
}

.analytics-v4-event time{
  color:var(--text-2);
  font-size:9.5px;
  white-space:nowrap;
}

/* Admin */
.admin-v3-hero{
  align-items:center;
}

.admin-v3-hero h1{
  font-size:22px;
}

.admin-v3-kpi-link{
  display:block;
  min-width:0;
  color:inherit;
  text-decoration:none;
}

.admin-v3-kpi{
  min-height:116px;
  transition:transform .16s ease,box-shadow .16s ease;
}

.admin-v3-kpi-link:hover .admin-v3-kpi{
  transform:translateY(-2px);
  box-shadow:var(--shadow-sm);
}

.admin-v3-kpi__head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
}

.admin-v3-kpi__head>span{
  font-size:21px;
}

.admin-v3-kpi__head small{
  color:var(--brand);
  font-size:9.5px;
}

.admin-v3-kpi>strong{
  display:block;
  margin-top:9px;
  font-size:23px;
  font-weight:900;
}

.admin-v3-kpi>b{
  display:block;
  margin-top:3px;
  font-size:11.5px;
}

.admin-v3-kpi>em{
  display:block;
  margin-top:5px;
  color:var(--text-2);
  font-style:normal;
  font-size:9.8px;
}

.admin-v3-two-col{
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(0,1fr);
  gap:14px;
  align-items:start;
}

.admin-v3-resource{
  min-width:0;
}

.admin-v3-resource__head a{
  color:var(--brand);
  text-decoration:none;
  font-size:10.5px;
  font-weight:750;
}

.admin-v3-platforms{
  grid-template-columns:repeat(3,minmax(0,1fr));
}

.admin-v3-platform-card{
  min-width:0;
  padding:12px;
  border:1px solid var(--border);
  border-radius:13px;
  background:var(--surface-2);
}

.admin-v3-platform-card__head{
  display:flex;
  align-items:center;
  gap:7px;
}

.admin-v3-platform-card__head strong{
  font-size:11.5px;
}

.admin-v3-platform-card>b{
  display:block;
  margin-top:9px;
  font-size:20px;
  font-weight:900;
}

.admin-v3-badges{
  display:flex;
  flex-wrap:wrap;
  gap:5px;
  margin-top:6px;
}

.admin-v3-core{
  min-width:0;
  overflow:hidden;
}

.admin-v3-core-kpis{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:9px;
  margin-bottom:10px;
}

.admin-v3-core-kpis a{
  min-width:0;
  padding:11px;
  border:1px solid var(--border);
  border-radius:12px;
  background:var(--surface-2);
  color:inherit;
  text-decoration:none;
  transition:transform .16s ease,border-color .16s ease;
}

.admin-v3-core-kpis a:hover{
  transform:translateY(-1px);
  border-color:color-mix(in srgb,var(--brand) 35%,var(--border));
}

.admin-v3-core-kpis span{
  display:block;
  font-size:17px;
}

.admin-v3-core-kpis strong{
  display:block;
  margin-top:5px;
  font-size:21px;
  font-weight:900;
}

.admin-v3-core-kpis b{
  display:block;
  margin-top:2px;
  color:var(--text-2);
  font-size:10px;
}

.admin-v3-core-main{
  display:grid;
  grid-template-columns:minmax(0,1.12fr) minmax(300px,.88fr);
  gap:10px;
}

.admin-v3-core-box{
  min-width:0;
  padding:12px;
  border:1px solid var(--border);
  border-radius:13px;
  background:var(--surface);
}

.admin-v3-box-title{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
  margin-bottom:10px;
}

.admin-v3-box-title strong{
  font-size:12px;
}

.admin-v3-box-title span{
  color:var(--text-2);
  font-size:9.5px;
}

.admin-v3-platform-bars{
  display:grid;
  gap:10px;
}

.admin-v3-platform-line{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
  margin-bottom:5px;
  font-size:10.5px;
}

.admin-v3-platform-line span{
  color:var(--text-2);
}

.admin-v3-bar{
  height:8px;
  border-radius:999px;
  background:var(--surface-2);
  overflow:hidden;
}

.admin-v3-bar__fill{
  display:block;
  height:100%;
  border-radius:999px;
}

.admin-v3-bar__fill--brand{
  background:var(--brand);
}

.admin-v3-bar__fill--success{
  background:var(--success);
}

.admin-v3-bar__fill--danger{
  background:var(--danger);
}

.admin-v3-platform-meta{
  display:flex;
  justify-content:space-between;
  gap:6px;
  margin-top:4px;
  color:var(--text-2);
  font-size:9px;
}

.admin-v3-summary-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:7px;
}

.admin-v3-summary-grid>div{
  padding:8px;
  border:1px solid var(--border);
  border-radius:9px;
  background:var(--surface-2);
}

.admin-v3-summary-grid span{
  display:block;
  color:var(--text-2);
  font-size:9.5px;
}

.admin-v3-summary-grid b{
  display:block;
  margin-top:3px;
  font-size:12px;
}

.admin-v3-success-row{
  display:flex;
  justify-content:space-between;
  gap:8px;
  padding:7px 0;
  border-bottom:1px solid var(--border);
  color:var(--text-2);
  font-size:9.8px;
}

.admin-v3-success-row:last-child{
  border-bottom:0;
  padding-bottom:0;
}

.admin-v3-success-row b{
  color:var(--text);
}

.admin-v3-plan-list{
  display:grid;
  gap:12px;
}

.admin-v3-plan-list>div>div{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
  margin-bottom:5px;
  font-size:10.5px;
}

.admin-v3-plan-list span{
  color:var(--text-2);
}

.admin-v3-usage-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:8px;
}

.admin-v3-usage-grid>div{
  padding:9px;
  border:1px solid var(--border);
  border-radius:10px;
  background:var(--surface-2);
}

.admin-v3-usage-grid span{
  display:block;
  color:var(--text-2);
  font-size:9.5px;
}

.admin-v3-usage-grid b{
  display:block;
  margin-top:4px;
  font-size:13px;
}

.admin-v3-quick{
  display:grid;
  grid-template-columns:repeat(5,minmax(0,1fr));
  gap:7px;
}

.admin-v3-quick__item{
  min-width:0;
  display:flex;
  align-items:center;
  gap:7px;
  padding:9px;
  border:1px solid var(--border);
  border-radius:10px;
  background:var(--surface-2);
  color:inherit;
  text-decoration:none;
  font-size:10px;
}

.admin-v3-quick__item>span{
  width:28px;
  height:28px;
  flex:0 0 28px;
  display:grid;
  place-items:center;
  border-radius:8px;
  background:var(--surface);
  color:var(--brand);
}

.admin-v3-quick__item>b{
  min-width:0;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

@media (max-width:1080px){
  .analytics-v4-kpis,
  .admin-v3-kpis{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

  .analytics-v4-platforms{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

  .admin-v3-platforms{
    grid-template-columns:repeat(3,minmax(0,1fr));
  }

  .analytics-v4-two-col,
  .admin-v3-two-col,
  .admin-v3-core-main{
    grid-template-columns:1fr;
  }
}

@media (max-width:760px){
  .analytics-v4-hero,
  .admin-v3-hero{
    align-items:flex-start;
    padding:17px;
  }

  .analytics-v4-hero h1,
  .admin-v3-hero h1{
    font-size:20px;
  }

  .analytics-v4-platforms,
  .analytics-v4-automation,
  .admin-v3-platforms{
    grid-template-columns:1fr;
  }

  .analytics-v4-statline{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

  .analytics-v4-revenue-grid{
    grid-template-columns:1fr;
  }

  .analytics-v4-day-summary{
    grid-template-columns:repeat(4,minmax(0,1fr));
  }

  .analytics-v4-event{
    grid-template-columns:8px minmax(0,1fr);
  }

  .analytics-v4-event time{
    grid-column:2;
  }

  .admin-v3-core-kpis{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

  .admin-v3-quick{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }
}

@media (max-width:520px){
  .analytics-v4-kpis,
  .admin-v3-kpis,
  .admin-v3-core-kpis,
  .admin-v3-summary-grid,
  .admin-v3-usage-grid{
    grid-template-columns:1fr;
  }

  .analytics-v4-day-summary{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

  .admin-v3-quick{
    grid-template-columns:1fr;
  }
}

